# 复制为 .env 后按需修改（所有项均有默认值，开发可留空）

# ---------- Qdrant ----------
# local = 嵌入式模式（开发用，无需 Docker）；server = 服务端模式（Docker 部署）
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=resume_agent

# ---------- 向量模型 ----------
# 开发档（默认，约 100MB）：BAAI/bge-small-zh-v1.5
# 生产档（效果更好，约 2.3GB）：jinaai/jina-embeddings-v3
DENSE_MODEL=BAAI/bge-small-zh-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=BAAI/bge-reranker-base
ENABLE_SPARSE=true
# 重排默认关闭以加快冷启动；部署前设 true 并下载模型即可启用
ENABLE_RERANK=false

# ---------- 检索参数 ----------
PREFETCH_LIMIT=20
FINAL_TOP_K=5
# 开启重排时：cross-encoder 分数低于此值判定为「无可靠依据」走拒答
RELEVANCE_THRESHOLD=0.3

# ---------- 候选人与服务 ----------
SUBJECT_NAME=张明
API_HOST=0.0.0.0
API_PORT=8000

# ---------- LLM（可选，配置后切换为「真实模型模式」）----------
# 三家均为 OpenAI 兼容协议，填任意一个即可；不填则走规则降级（演示模式）
# LLM_PROVIDER=deepseek
# LLM_API_KEY=sk-xxxxxx
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat
